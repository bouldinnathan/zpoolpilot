[Unit]
Description=ZpoolPilot no-spin-up hardware collector
Documentation=man:zpoolpilot(8)
After=zfs-import.target

[Service]
Type=oneshot
ExecStart=/usr/bin/zpoolpilot --config /etc/zpoolpilot/config.toml --read-only monitor collect --profile hardware --wait
User=root
Group=zpoolpilot
UMask=0027
SuccessExitStatus=1 2 3
NoNewPrivileges=yes
PrivateTmp=yes
ProtectHome=yes
ProtectSystem=strict
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
ProtectProc=invisible
ReadWritePaths=/var/lib/zpoolpilot /run/zpoolpilot/collect
RestrictAddressFamilies=AF_UNIX AF_NETLINK
RestrictNamespaces=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
RestrictRealtime=yes
RemoveIPC=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service @raw-io
CapabilityBoundingSet=CAP_DAC_OVERRIDE CAP_DAC_READ_SEARCH CAP_SYS_ADMIN CAP_SYS_RAWIO
AmbientCapabilities=CAP_DAC_OVERRIDE CAP_DAC_READ_SEARCH CAP_SYS_ADMIN CAP_SYS_RAWIO
IPAddressDeny=any
